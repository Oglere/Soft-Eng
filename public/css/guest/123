body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    height: 100%;
}

header {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 40px;
    background-color: #fffce4 !important;
    box-shadow: 0 1px 8px #00000081;
    color: #fffce4;
    z-index: 1000;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 15px;
}
/* Nav for desktop */
.header-nav {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* Hamburger hidden on desktop */
.hamburger {
    display: none;
    font-size: 22px;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
}

.header-left img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    background: white;
    border: 2px solid white;
}

.header-left h2 {
    margin: 0;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #fffce4;
}
.loginbutton {
    display: flex;
    align-items: center;
    gap: 5px;
    text-decoration: none;
    color: #0e100f;
    padding: 8px 12px;
    border-radius: 6px;
    transition: background 0.2s;
}
.loginbutton h4 {
    margin: 0;
    font-size: 16px;
    font-weight: normal;
    color: white;
}

.loginbutton:hover {
    opacity: 0.8;
}

main {
    height: 100%;
    text-align: center;
    min-height: calc(95vh - 140px);
    background-color: #fffce4 !important;
}

footer {
    border-top: 1px #0e100f solid;
    padding: 10px;
    background-color: #fffce4;
    color: #0e100f;
}

.brand {
    flex-direction: column;
    margin-top: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}

.brand .logo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #0e100f;
    background-color: white;
}

.brand-text {
    color: #0c1c43;
    font-size: 40px;
}

.site-name {
    font-size: 36px;
    font-weight: bold;
    color: #0e100f;
    margin: 0;
    letter-spacing: 2px;
}

.tagline {
    font-size: 16px;
    color: #333;
    margin-top: 5px;
}

.search {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 40px auto;
    max-width: 990px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid #0c1c43;
}

.search input {
    flex: 1;
    padding: 12px 15px;
    border: none;
    outline: none;
    font-size: 16px;
}

.search button {
    background-color: #0c1c43;
    border: none;
    padding: 12px 18px;
    cursor: pointer;
}

.search button svg {
    stroke: white;
}

.categories {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

/* Base card style */
.category-card {
    width: 150px;
    height: 150px;
    border: 2px solid #0c1c43;
    border-radius: 8px;
    padding: 15px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    background-color: white;
    transition: 0.3s;
    cursor: pointer;
    position: relative;
}

/* Hover style */
.category-card:hover {
    background-color: #e6f0ff;
    transform: translateY(-5px);
}

/* When checkbox is checked */
.category-card input:checked + img,
.category-card input:checked + img + span {
    filter: brightness(0.9);
}

.category-card input:checked ~ * {
    background-color: #e6f0ff;
}

.category-card:has(input:checked) {
    background-color: #e6f0ff;
    border-color: #00346b;
    box-shadow: 0 4px 10px rgba(0, 123, 255, 0.15);
    transform: translateY(-5px);
}

/* Image and text styling */
.category-card img {
    width: 100px;
    height: 100px;
    object-fit: contain;
    pointer-events: none;
}

.category-card span {
    font-size: 14px;
    font-weight: bold;
    color: #0c1c43;
    pointer-events: none;
}

/* Smooth transitions */
.category-card,
.category-card * {
    transition: all 0.25s ease;
}

/* User Dropdown */
.user-dropdown {
    position: relative;
    display: inline-block;
}

.user-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: #0e100f;
    cursor: pointer;
    font-size: 16px;
    padding: 6px 12px;
    border-radius: 6px;
    transition: background 0.2s ease;
    font-weight: 500;
}

.user-toggle:hover {
    background: rgba(255, 255, 255, 0.15);
}

.user-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid white;
    background: #ddd;
}

.user-menu {
    display: none;
    position: absolute;
    right: 0;
    top: 110%;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    list-style: none;
    margin: 0;
    padding: 6px 0;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    min-width: 100px;
    z-index: 1000;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.25s ease;
}

.user-menu li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    text-decoration: none;
    font-size: 15px;
    color: #333;
    transition: background 0.2s ease, color 0.2s ease;
}

.user-menu li a i {
    color: #0c1c43; /* academic theme blue */
    font-size: 16px;
}

.user-menu li a:hover {
    background: #f0f4ff;
    color: #0c1c43;
}

/* Active Dropdown */
.user-dropdown.active .user-menu {
    display: block;
    opacity: 1;
    transform: translateY(0);
}

/* Mobile */
@media (max-width: 768px) {
    .user-toggle span {
        display: none;
    }
}

/* Mobile responsive */
@media (max-width: 768px) {
    header {
        padding: 10px 20px;
    }

    .header-nav {
        position: absolute;
        top: 70px;
        right: 0;
        background: #0c1c43;
        flex-direction: column;
        align-items: flex-start;
        width: 200px;
        display: none;
        padding: 15px;
    }

    .header-nav.active {
        display: flex;
    }

    .hamburger {
        display: block;
    }
}

.date-range {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin: 20px auto;
    flex-wrap: nowrap;
    flex-direction: row;
}

.date-field {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-weight: bold;
    color: #0c1c43;
}

.date-field label {
    margin-bottom: 5px;
    font-size: 14px;
    color: #0c1c43;
}

.date-field input[type="date"] {
    padding: 8px 10px;
    border: 2px solid #0c1c43;
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
    transition: 0.3s;
}

.date-field input[type="date"]:hover,
.date-field input[type="date"]:focus {
    background-color: #e6f0ff;
    border-color: #0e100f;
}

.category-card.active {
    background-color: #e6f0ff;
    transform: translateY(-5px);
    border-color: #0e100f;
}
